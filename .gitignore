# Dependencies
node_modules/
.pnp
.pnp.js

# Build output. Anchored: an unanchored build/ also matches scripts/build/, the
# phase directory, and would silently drop a new script added there.
/dist/
/build/
/.cache/

# The two assembled npm packages. Unlike the payload below, a package is served from
# the registry rather than from the git tag, and CI rebuilds it from the tagged
# sources, so committing it would only make every diff unreadable. Every gate that
# walks frameworks/ skips a directory named dist for the same reason.
/frameworks/react/dist/
/frameworks/angular/dist/

# Build products a script under scripts/ rewrites. The .generated. infix says a script
# writes the file; this block says which of those are untracked. Rebuild them with
# `bun run build` -- see scripts/build/README.md.
#
# Only what Arena's own tooling reads is here. The consumer payload stays tracked --
# contracts/design-generated/, assets/fonts/, Tokens.generated.*, Api.generated.* and
# frameworks/tailwind/components/**/*.manifest.generated.ts -- because the Claude Code
# plugin is served from the git tag. Ignoring those would ship a tag whose
# intro/styles.css @imports resolve to nothing, and the page renders unstyled with no
# console error. Each pattern is anchored for the same reason /build/ above is:
# frameworks/react/ holds a TRACKED Tokens.generated.js at its layer root, so a bare
# frameworks/react/**/*.generated.js would swallow it silently.
/frameworks/react/vendor/*.generated.js
/frameworks/react/components/**/*.generated.js
/frameworks/react/ui-kits/**/*.generated.js
/frameworks/tailwind/Utilities.generated.css

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Misc
.thumbnail
coverage/

# SDD scratch (ledger, task briefs, review packages) is machine-local, not product.
.superpowers/

# Claude Code local settings and task lock, machine-local, not product.
.claude/
