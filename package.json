{
  "name": "arena",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@angular/cdk": "22.0.5",
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@happy-dom/global-registrator": "^20.11.0",
    "@phosphor-icons/web": "2.1.2",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "happy-dom": "^20.11.0",
    "ng-packagr": "22.0.1",
    "react": "18",
    "react-dom": "18",
    "rxjs": "7.8.2",
    "style-dictionary": "^4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "scripts": {
    "demos": "bun run build && bun scripts/serve.mjs",
    "build": "bun run generate:tokens && bun run generate:api && bun run generate:catalog && bun run build:react-barrel && bun run build:tailwind && bun run build:vendor && bun run build:demos && bun run build:angular-demo",
    "generate:tokens": "bun scripts/generate/arena/generate-tokens.mjs",
    "generate:api": "bun scripts/generate/arena/generate-api-types.mjs && bun scripts/generate/arena/generate-member-docs.mjs",
    "generate:catalog": "bun scripts/generate/arena/generate-catalog.mjs",
    "build:tailwind": "bun scripts/build/tailwind/build-tailwind.mjs",
    "build:vendor": "bun scripts/build/react/build-vendor.mjs",
    "build:demos": "bun scripts/build/react/build-demos.mjs",
    "build:react-barrel": "bun scripts/build/react/build-react-barrel.mjs",
    "build:angular-tests": "bun scripts/build/angular/build-angular-tests.mjs",
    "build:angular-demo": "bun scripts/build/angular/build-angular-demo.mjs",
    "build:react-package": "bun scripts/build/react/build-react-package.mjs",
    "build:angular-package": "bun scripts/build/angular/build-angular-package.mjs",
    "build:packages": "bun run build:react-barrel && bun run build:react-package && bun run build:angular-package",
    "check:dtcg": "bun scripts/check/core/check-dtcg.mjs",
    "check:tokens": "bun scripts/check/core/check-tokens-generated.mjs",
    "check:fonts": "bun scripts/check/core/check-fonts-generated.mjs",
    "check:ramp": "bun scripts/check/core/check-ramp.mjs",
    "check:text-contrast": "bun scripts/check/core/check-text-contrast.mjs",
    "check:demos": "bun scripts/check/react/check-demos-generated.mjs",
    "check:react-barrel": "bun scripts/check/react/check-react-barrel.mjs",
    "check:react-types": "bun scripts/check/react/check-react-types.mjs",
    "check:vendor": "bun scripts/check/react/check-vendor-generated.mjs",
    "check:angular": "bun scripts/check/angular/check-angular.mjs",
    "check:angular-demos": "bun scripts/check/angular/check-angular-demos.mjs",
    "check:assertions": "bun scripts/check/angular/check-assertions.mjs",
    "check:cdk": "bun scripts/check/angular/check-cdk.mjs",
    "check:tailwind": "bun scripts/check/tailwind/check-tailwind.mjs",
    "check:tailwind-generated": "bun scripts/check/tailwind/check-tailwind-generated.mjs",
    "check:coverage": "bun scripts/check/tailwind/check-tailwind-coverage.mjs",
    "check:surface-parity": "bun scripts/check/tailwind/check-surface-parity.mjs",
    "check:radius": "bun scripts/check/tailwind/check-radius-tokens.mjs",
    "check:arbitrary": "bun scripts/check/tailwind/check-arbitrary-values.mjs",
    "check:docs": "bun scripts/check/arena/check-docs.mjs",
    "check:generated": "bun scripts/check/arena/check-generated.mjs",
    "check:catalog": "bun scripts/check/arena/check-catalog.mjs",
    "check:script-tokens": "bun scripts/check/arena/check-script-tokens.mjs",
    "check:duplicate-constants": "bun scripts/check/arena/check-duplicate-constants.mjs",
    "check:dimensions": "bun scripts/check/arena/check-dimension-literals.mjs",
    "check:states": "bun scripts/check/arena/check-manifest-states.mjs",
    "check:layer-independence": "bun scripts/check/arena/check-layer-independence.mjs",
    "check:structure": "bun scripts/check/arena/check-structure.mjs",
    "check:contracts": "bun scripts/check/arena/check-contracts.mjs",
    "check:behaviour": "bun scripts/check/arena/check-behaviour.mjs",
    "check:compliance": "bun scripts/check/arena/check-compliance.mjs",
    "check:api": "bun scripts/check/arena/check-api.mjs",
    "check:focus-trap": "bun scripts/check/arena/check-focus-trap.mjs",
    "check:cards": "bun scripts/check/arena/check-card-viewports.mjs",
    "check:packages": "bun scripts/check/arena/check-packages.mjs",
    "check": "bun scripts/check/arena/check-all.mjs",
    "ci:summarize": "bun scripts/ci/arena/summarize-tests.mjs",
    "test:scripts": "bun test scripts",
    "test:react": "bun test frameworks/react --path-ignore-patterns='**/*.dom.test.*'",
    "test:react-dom": "bun test --preload ./frameworks/react/test/Preload.js '.dom.test.'",
    "test:angular": "bun run build:angular-tests && bun test frameworks/angular/build/test/angular",
    "test": "bun run build:angular-tests && bun test scripts frameworks/react frameworks/angular/build/test/angular --path-ignore-patterns='**/*.dom.test.*' && bun test --preload ./frameworks/react/test/Preload.js '.dom.test.'"
  }
}
